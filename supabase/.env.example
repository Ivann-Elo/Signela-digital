# Local env for `supabase functions serve` (not used in the deployed app —
# in production these are Supabase project secrets, set via
# `supabase secrets set MAKE_WEBHOOK_URL=...` or the Supabase dashboard).
#
# Copy this file to `supabase/.env` (already gitignored) and fill in the
# real value. Never commit the real webhook URL.

# Make.com scenario webhook that receives every lead from the site
# (Make > Scenario > Webhooks > Add a webhook).
MAKE_WEBHOOK_URL=
